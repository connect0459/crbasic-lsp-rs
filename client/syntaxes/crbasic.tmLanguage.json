{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CRBasic",
  "scopeName": "source.crbasic",
  "fileTypes": [".cr1", ".cr1x", ".cr2", ".cr3", ".cr5", ".cr6", ".cr8", ".cr9x", ".cr300", ".crb", ".dld"],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#line-continuation"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#control-keywords"
    },
    {
      "include": "#declaration-keywords"
    },
    {
      "include": "#structure-keywords"
    },
    {
      "include": "#builtin-functions-measurement"
    },
    {
      "include": "#builtin-functions-communication"
    },
    {
      "include": "#builtin-functions-data"
    },
    {
      "include": "#builtin-functions-general"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "name": "comment.line.single-quote.crbasic",
      "match": "'.*$"
    },
    "line-continuation": {
      "name": "punctuation.separator.continuation.crbasic",
      "match": "\\s_$"
    },
    "strings": {
      "name": "string.quoted.double.crbasic",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.crbasic",
          "match": "\\\\."
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.crbasic",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.crbasic",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "control-keywords": {
      "name": "keyword.control.crbasic",
      "match": "(?i)\\b(If|Then|Else|ElseIf|EndIf|For|To|Step|Next|Do|While|Until|Loop|Exit|Continue|Select|Case|EndSelect)\\b"
    },
    "declaration-keywords": {
      "name": "storage.type.crbasic",
      "match": "(?i)\\b(Public|Dim|Const|Alias|As|Units|Long|Float|String|Boolean|FP2|IEEE4|IEEE8)\\b"
    },
    "structure-keywords": {
      "patterns": [
        {
          "name": "keyword.control.program.crbasic",
          "match": "(?i)\\b(BeginProg|EndProg)\\b"
        },
        {
          "name": "keyword.control.datatable.crbasic",
          "match": "(?i)\\b(DataTable|EndTable|DataInterval)\\b"
        },
        {
          "name": "keyword.control.function.crbasic",
          "match": "(?i)\\b(Function|EndFunction|Sub|EndSub)\\b"
        },
        {
          "name": "keyword.control.scan.crbasic",
          "match": "(?i)\\b(Scan|NextScan)\\b"
        }
      ]
    },
    "builtin-functions-measurement": {
      "name": "support.function.measurement.crbasic",
      "match": "(?i)\\b(Battery|PanelTemp|Voltage|VoltSE|VoltDiff|BrHalf|BrFull|Therm107|Therm108|Therm109|TCDiff|Resistance|PeriodAvg|PulseCount|FreqCount|Thermocouple|PortSet|SDI12Recorder|PulsePort|ExciteV|BrHalf3W|BrHalf4W|BrFull6W|TCDiff|TCSE)\\b"
    },
    "builtin-functions-communication": {
      "name": "support.function.communication.crbasic",
      "match": "(?i)\\b(SerialOpen|SerialClose|SerialIn|SerialOut|SerialInRecord|SerialOutBlock|SerialFlush|ModbusMaster|SDI12Recorder|TCPOpen|TCPClose|UDPOpen|UDPClose|EmailRelay|PPPOpen|PPPClose|FTPClient|HTTPGet|HTTPPost|HTTPPut)\\b"
    },
    "builtin-functions-data": {
      "name": "support.function.data.crbasic",
      "match": "(?i)\\b(Sample|Average|StdDev|Variance|Minimum|Maximum|Totalize|Histogram|FieldNames|TableName|CardOut|NewFile|FileManage|FileOpen|FileClose|FileRead|FileWrite|FileCopy|FileRename|FileSize|FileTime|FileList)\\b"
    },
    "builtin-functions-general": {
      "patterns": [
        {
          "name": "support.function.string.crbasic",
          "match": "(?i)\\b(SplitStr|FormatFloat|FormatLong|Mid|Left|Right|Len|InStr|LCase|UCase|Trim|RTrim|LTrim|Replace|Chr|Asc|StrComp|CheckSum|HexToDec|DecToHex)\\b"
        },
        {
          "name": "support.function.math.crbasic",
          "match": "(?i)\\b(ABS|SGN|SQR|EXP|LN|LOG|SIN|COS|TAN|ASIN|ACOS|ATAN|ATN2|INT|FIX|ROUND|MOD|RND|Ceiling|Floor)\\b"
        },
        {
          "name": "support.function.time.crbasic",
          "match": "(?i)\\b(RealTime|TimeIntoInterval|Timer|Delay|CallTable|SetStatus|Watch|MoveBytes|ArrayLength|NAN|IsNAN)\\b"
        },
        {
          "name": "support.function.logical.crbasic",
          "match": "(?i)\\b(IIF|NOT|AND|OR|XOR|TRUE|FALSE)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.crbasic",
          "match": "(=|<>|<|>|<=|>=)"
        },
        {
          "name": "keyword.operator.arithmetic.crbasic",
          "match": "(\\+|-|\\*|/|\\^|MOD)"
        },
        {
          "name": "keyword.operator.logical.crbasic",
          "match": "(?i)\\b(AND|OR|NOT|XOR)\\b"
        },
        {
          "name": "keyword.operator.assignment.crbasic",
          "match": "="
        }
      ]
    },
    "identifiers": {
      "name": "variable.other.crbasic",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}
